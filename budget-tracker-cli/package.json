{
  "name": "budget-tracker-cli",
  "version": "1.0.0",
  "description": "Interactive personal finance CLI with Inquirer and TypeScript",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "test": "npm run build && npm run test:types && node --test tests/*.test.mjs",
    "build": "tsc",
    "start": "tsx src/index.ts",
    "dev": "tsc --watch",
    "start:compiled": "node dist/index.js",
    "test:types": "tsc -p tsconfig.tests.json",
    "demo": "tsx src/demos/homework-demo.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/uuid": "9.0.8",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "inquirer": "12.11.1",
    "moment": "2.30.1",
    "reflect-metadata": "0.2.2",
    "uuid": "9.0.1"
  },
  "engines": {
    "node": ">=22"
  }
}
